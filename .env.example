# Add these lines to your app's .env.example exactly as they are, and to .env with your own
# Daraja sandbox values from the developer portal. Never commit .env.
# APP_URL must be the public HTTPS address of your app (a tunnel while developing):
# the M-Pesa result address is built from it.
# MPESA_CALLBACK_TOKEN must be a random value of at least 32 characters; the app refuses
# the placeholder. Generate one with: php -r "echo bin2hex(random_bytes(32));"
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=changeme
MPESA_CONSUMER_SECRET=changeme
MPESA_SHORTCODE=changeme
MPESA_PASSKEY=changeme
MPESA_CALLBACK_TOKEN=changeme
